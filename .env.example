# GoPlanner Environment Configuration
# Copy this file to .env and fill in your own values:
#   Copy-Item .env.example .env
# NEVER commit the real .env file (it contains secrets).

# Application
APP_NAME="GoPlanner"
# Set this to the URL where the app is served, e.g. http://localhost/goplanner
APP_URL="http://localhost/goplanner"
# URL path prefix (folder name under htdocs), e.g. /goplanner
APP_BASE_PATH="/goplanner"
APP_ENV="development"

# Database
DB_HOST="localhost"
DB_NAME="goplanner_db"
DB_USERNAME="root"
DB_PASSWORD=""

# Mail (SMTP)
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_SMTP_SECURE="tls"
MAIL_USERNAME=""
# Gmail: use an App Password (Google Account > Security > App passwords)
MAIL_PASSWORD=""
MAIL_FROM_EMAIL=""
MAIL_FROM_NAME="GoPlanner"

# Calendar
CALENDAR_NAME="GoPlanner"
CALENDAR_TIMEZONE="Asia/Manila"

# Mail toggle (true/false) - global email switch used by MailHelper
MAIL_ENABLED=true

# Secret for web-triggering the email queue processor:
#   /api/mail/process_queue.php?key=<secret>
GOPLANNER_CRON_SECRET=""

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
